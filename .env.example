# Fitcheck landing environment variables

# AWS DynamoDB lead storage
# When DYNAMODB_TABLE and AWS_REGION are set, lead submissions are persisted
# to DynamoDB. Otherwise they fall back to /tmp/fitcheck-leads/leads.json.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
DYNAMODB_TABLE=fitcheck-leads
